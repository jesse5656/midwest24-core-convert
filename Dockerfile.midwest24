# syntax=docker/dockerfile:1

ARG UPSTREAM_IMAGE=ghcr.io/c4illin/convertx

FROM oven/bun:1.2.2 AS branded-build

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .
RUN bun run build

FROM ${UPSTREAM_IMAGE}

ARG SOURCE_COMMIT=unknown
ARG UPSTREAM_BASE=unknown

LABEL org.opencontainers.image.title="Midwest24 Core Convert"
LABEL org.opencontainers.image.description="Midwest24-branded ConvertX runtime"
LABEL org.opencontainers.image.source="https://github.com/jesse5656/midwest24-core-convert"
LABEL org.opencontainers.image.version="0.18.0-midwest24.2"
LABEL com.midwest24.product="Midwest24 Core Convert"
LABEL com.midwest24.source_commit="${SOURCE_COMMIT}"
LABEL com.midwest24.upstream_base="${UPSTREAM_BASE}"

COPY --from=branded-build /app/public/ /app/public/
COPY --from=branded-build /app/dist/ /app/dist/
